<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title><!--title|html--></title>
        <!--page_start-->
        <style>
            body {
                font:
                    16px/1.6 system-ui,
                    sans-serif;
                margin: 0;
                background: #f4f6f8;
                color: #243247;
            }
            .cf-page {
                max-width: 1100px;
                margin: 32px auto;
                padding: 24px;
                background: white;
                border-radius: 12px;
            }
            .form-group {
                margin: 16px 0;
            }
            .form-control {
                box-sizing: border-box;
                width: 100%;
                padding: 10px;
                border: 1px solid #bcc9d7;
                border-radius: 5px;
            }
            textarea {
                min-height: 100px;
            }
            small {
                display: block;
                color: #65758a;
            }
            table {
                border-collapse: collapse;
                width: 100%;
            }
            th,
            td {
                padding: 10px;
                border-bottom: 1px solid #ddd;
                text-align: left;
            }
            button,
            .btn {
                cursor: pointer;
                display: inline-block;
                padding: 7px 14px;
                margin: 3px;
                border: 1px solid #a6b7ca;
                border-radius: 5px;
                background: #f5f8fc;
                color: #24548a;
                text-decoration: none;
            }
            .table-responsive {
                overflow: auto;
            }
            a {
                color: #24548a;
            }
            @media print {
                .no-print {
                    display: none;
                }
                body {
                    background: #fff;
                }
                .cf-page {
                    margin: 0;
                    padding: 0;
                }
            }
        </style>
    </head>
    <body>
        <main class="cf-page"><!--main--></main>
        <!--page_end-->
    </body>
</html>
