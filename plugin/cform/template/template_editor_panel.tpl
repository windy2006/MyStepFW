<div data-cf-template-panel="<!--key|html-->" <!--hidden-->>
    <h4>
        <!--label|html-->
        <small data-cf-template-state><!--status|html--></small>
    </h4>

    <p data-cf-event-note><!--event_note|html--></p>

    <textarea
        class="form-control cf-source-editor"
        name="<!--input_name|html-->"
        rows="16"
        spellcheck="false"
        aria-label="<!--label|html-->"
    ><!--source|html--></textarea>

    <div class="cf-toolbar">
        <button type="button" class="btn btn-light" data-cf-copy-default>复制默认到此表单</button>
        <button type="button" class="btn btn-light" data-cf-reset-template>恢复继承默认</button>
    </div>

    <details>
        <summary>查看统一默认源码</summary>
        <pre data-cf-default-source><!--default_source|html--></pre>
    </details>
</div>
